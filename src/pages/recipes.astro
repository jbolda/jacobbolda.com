---
import { getCollection } from "astro:content";
import PageLayout from "~/layouts/PageLayout.astro";
import Recipes, { RecipeWrap } from "~/components/pages/recipes.jsx";
import { Picture } from "astro:assets";

const recipeCollection = await getCollection("recipes");
---

<PageLayout>
  <Recipes recipes={recipeCollection}>
    {
      recipeCollection.map((r) => (
        <RecipeWrap key={r.id} recipe={r}>
          {r.data.image ? (
            <Picture
              slot="image"
              class="h-48 w-full object-cover"
              src={r.data.image}
              alt={`close up view of ${r.data.name}`}
            />
          ) : null}
        </RecipeWrap>
      ))
    }
  </Recipes>
</PageLayout>
