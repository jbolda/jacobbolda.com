---
import { getCollection } from "astro:content";
import PageLayout from "~/layouts/PageLayout.astro";
import { RecipeCards, RecipeWrap } from "~/components/pages/recipes.js";
import { Image } from "astro:assets";

const recipeCollection = await getCollection("recipes");
---

<PageLayout>
  <RecipeCards>
    {
      recipeCollection.map((r) => (
        <RecipeWrap recipe={r}>
          <div class="rounded-lg shadow-lg">
            {r.data.images ? (
              <Image
                inferSize={true}
                src={r.data.images[0].url}
                alt={`close up view of ${r.data.name}`}
              />
            ) : null}
          </div>
        </RecipeWrap>
      ))
    }
  </RecipeCards>
</PageLayout>
