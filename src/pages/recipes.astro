---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PageLayout from "~/layouts/PageLayout.astro";
import { RecipeCards, RecipeWrap } from "~/components/pages/recipes.js";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/recipes/**/*.{jpg,jpeg,png,webp}",
  { eager: true }
);

const recipeCollection = await getCollection("recipes");
---

<PageLayout>
  <RecipeCards>
    {
      recipeCollection.map((r) => {
        const imageMeta = r.data.image
          ? images[`/src/content/recipes/${r.id}/${r.data.image}`] ??
            images[`/src/content/recipes/${r.data.image}`]
          : undefined;
        return (
          <RecipeWrap recipe={r}>
            <div class="rounded-lg shadow-lg">
              {imageMeta ? (
                <Image
                  src={imageMeta.default}
                  alt={r.data.title}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="bg-gray-200 h-48 flex items-center justify-center text-gray-500">
                  Pretend this is a tasty looking meal because I ate it before I could take a picture
                </div>
              )}
            </div>
          </RecipeWrap>
        );
      })
    }
  </RecipeCards>
</PageLayout>
