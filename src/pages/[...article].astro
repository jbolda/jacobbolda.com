---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ArticleLayout from "~/layouts/ArticleLayout.astro";
import components from "~/components/common/mdxComponents";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const drafts = await getCollection("drafts");
  const notes = await getCollection("notes");
  const engagements = await getCollection("engagements");
  // a draft sharing a slug with published content is a revision of it —
  // the published entry keeps the URL, the draft yields
  const byId = new Map(
    [...drafts, ...articles, ...notes, ...engagements].map((entry) => [
      entry.id,
      entry,
    ]),
  );
  return [...byId.values()].map((article) => ({
    params: { article: article.id },
    props: article,
  }));
}
type Props =
  | CollectionEntry<"articles">
  | CollectionEntry<"drafts">
  | CollectionEntry<"notes">;

const article = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout {...article.data}>
  <Content components={components} />
</ArticleLayout>
