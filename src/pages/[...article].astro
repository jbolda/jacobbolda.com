---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ArticleLayout from "~/layouts/ArticleLayout.astro";
import components from "~/components/common/mdxComponents";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const notes = await getCollection("notes");
  const engagements = await getCollection("engagements");
  return [...articles, ...notes, ...engagements].map((article) => ({
    params: { article: article.id },
    props: article,
  }));
}
type Props =
  | CollectionEntry<"articles">
  | CollectionEntry<"notes">
  | CollectionEntry<"engagements">;

const article = Astro.props;
const { Content, headings } = await render(article);
const hasContentTitle = headings.some(
  ({ depth, text }) =>
    depth === 1 && text?.trim() && text.trim() !== "{props.title}",
);
const showTitle = !hasContentTitle;
---

<ArticleLayout {...article.data} showTitle={showTitle}>
  <Content components={components} {...article.data} />
</ArticleLayout>
