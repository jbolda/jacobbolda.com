---
import { getCollection } from "astro:content";
import PageLayout from "~/layouts/PageLayout.astro";
import ArticleComponent from "~/components/pages/articles.jsx";

const dateOf = (article) =>
  article.data.updated ?? article.data.written;

const sortByDate = (a, b) => {
  const aDate = dateOf(a);
  const bDate = dateOf(b);
  if (aDate && bDate) {
    const diff = new Date(bDate) - new Date(aDate);
    if (diff) return diff;
  } else if (aDate && !bDate) {
    return -1;
  } else if (!aDate && bDate) {
    return 1;
  }
  return a.data.title.localeCompare(b.data.title);
};

const articlesCollection = await getCollection("articles");
const draftsCollection = await getCollection("drafts");
const notesCollection = await getCollection("notes");

const articles = [
  ...articlesCollection,
  ...draftsCollection,
  ...notesCollection,
]
  .sort(sortByDate)
  .map((article) => ({
    ...article.data,
    slug: article.id.startsWith("/") ? article.id : `/${article.id}`,
  }));
---

<PageLayout>
  <ArticleComponent articles={articles} />
</PageLayout>
