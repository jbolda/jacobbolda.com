---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { InferGetStaticPropsType, GetStaticPaths } from "astro";
import PageLayout from "~/layouts/PageLayout.astro";
import { RecipeEntry, RecipeChrome } from "~/components/pages/recipe.js";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/recipes/**/*.{jpg,jpeg,png,webp}",
  { eager: true }
);

export const getStaticPaths = (async () => {
  const recipeCollection = await getCollection("recipes");
  return recipeCollection.map((recipe) => {
    return {
      params: { recipe: recipe.id },
      props: recipe,
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const recipe = Astro.props;
const imageMeta = recipe.data.image
  ? images[`/src/content/recipes/${recipe.id}/${recipe.data.image}`] ??
    images[`/src/content/recipes/${recipe.data.image}`]
  : undefined;
---

<PageLayout>
  <RecipeChrome recipe={recipe}>
    <RecipeEntry recipe={recipe}>
      {imageMeta ? (
        <Image
          src={imageMeta.default}
          alt={recipe.data.title}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="rounded-lg shadow-lg object-cover w-full h-full"
          loading="eager"
        />
      ) : (
        <div class="bg-gray-200 h-64 flex items-center justify-center text-gray-500 rounded-lg shadow-lg">
          Recipe Image
        </div>
      )}
    </RecipeEntry>
  </RecipeChrome>
</PageLayout>
