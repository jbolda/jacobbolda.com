---
import { getCollection } from "astro:content";
import type { InferGetStaticPropsType, GetStaticPaths } from "astro";
import PageLayout from "~/layouts/PageLayout.astro";
import { RecipeEntry, RecipeChrome } from "~/components/pages/recipe.js";
import { Image } from "astro:assets";

export const getStaticPaths = (async () => {
  const recipeCollection = await getCollection("recipes");
  return recipeCollection.map((recipe) => {
    return {
      params: { recipe: recipe.data.slug },
      props: recipe,
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const recipe = Astro.props;
---

<PageLayout>
  <RecipeChrome recipe={recipe}>
    <RecipeEntry recipe={recipe}>
      {
        recipe.data.images ? (
          <Image
            inferSize={true}
            class="rounded-lg shadow-lg object-cover object-center"
            src={recipe.data.images[0].url}
            alt={`Image of ${recipe.data.name}`}
          />
        ) : null
      }
    </RecipeEntry>
  </RecipeChrome>
</PageLayout>
