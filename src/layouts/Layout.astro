---
import "../styles/global.css";

const pageTitle = Astro.props.title
  ? `Jacob Bolda | ${Astro.props.title}`
  : "Jacob Bolda";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <script is:inline>
      function getInitialColorMode() {
        const persistedColorPreference = window.localStorage.getItem("theme");
        if (
          persistedColorPreference === "dark" ||
          persistedColorPreference === "light"
        ) {
          return persistedColorPreference;
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }
      const applyColorMode = (documentToUpdate) => {
        documentToUpdate.documentElement.classList.toggle(
          "dark",
          getInitialColorMode() !== "light",
        );
      };
      applyColorMode(document);
      document.addEventListener("astro:before-swap", (event) => {
        applyColorMode(event.newDocument);
      });
    </script>
    <script
      defer
      data-domain="jacobbolda.com"
      data-api="/feedback/api/event"
      src="/feedback/js/script.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
